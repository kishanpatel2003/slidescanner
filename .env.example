# Anthropic API key for vision extraction - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-6)
VISION_MODEL=

# Optional demo mode: serve the bundled mock deck instead of calling external APIs (set to 1 to enable)
MOCK_DECK=

# Optional demo extraction delay in milliseconds (default: 700)
MOCK_EXTRACT_DELAY_MS=
